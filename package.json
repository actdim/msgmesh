{
    "name": "@actdim/msgmesh",
    "version": "1.7.0",
    "description": "High-performance, type-safe message bus for TypeScript. Pub/sub, async/await RPC, streaming, and channel-based routing powered by RxJS.",
    "author": "Pavel Borodaev",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/actdim/msgmesh.git"
    },
    "bugs": {
        "url": "https://github.com/actdim/msgmesh/issues"
    },
    "homepage": "https://github.com/actdim/msgmesh/#readme",
    "keywords": [
        "typescript",
        "message-bus",
        "event-bus",
        "message-mesh",
        "service-bus",
        "in-memory",
        "pubsub",
        "rpc",
        "request-response",
        "event-driven",
        "rxjs",
        "reactive",
        "async",
        "type-safe",
        "microfrontends"
    ],
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE",
        "AGENTS.md",
        "CLAUDE.md",
        "llms.txt",
        "llms-full.txt"
    ],
    "ai": {
        "instructions": "./AGENTS.md",
        "docs": "./docs",
        "llms": "./llms.txt",
        "llms-full": "./llms-full.txt"
    },
    "llms": "./llms.txt",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.es.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "dist/*.d.ts"
            ]
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.21.0",
    "scripts": {
        "test": "npx vitest --config=vitest.node.config.ts --no-cache",
        "test:w": "npx vitest --config=vitest.node.config.ts --watch",
        "test:v8": "npx vite",
        "lint": "eslint \"./**/*.{ts,tsx}\" -f visualstudio --report-unused-disable-directives --max-warnings 0",
        "build": "tsc -b tsconfig.json && vite build",
        "pnpm:u": "pnpm update",
        "pnpm:ou": "pnpm outdated",
        "ncu:l": "ncu",
        "ncu:u": "ncu -u",
        "ncu:ud": "ncu -u --dev",
        "nvm:la": "nvm list available",
        "nvm:il": "nvm install lts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b tsconfig.json",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "peerDependencies": {
        "@actdim/utico": ">=1.7.0",
        "rxjs": ">=7.8.0",
        "uuid": ">=13.0.0"
    },
    "devDependencies": {
        "@braintree/sanitize-url": "^7.1.2",
        "@eslint/js": "^9.39.5",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.10.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "chai": "^6.2.0",
        "cytoscape": "^3.34.3",
        "cytoscape-cose-bilkent": "^4.1.0",
        "dayjs": "^1.11.23",
        "debug": "^4.4.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-formatter-visualstudio": "^9.0.1",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^16.5.0",
        "mermaid": "^11.4.1",
        "mocha": "^11.7.5",
        "npm-check-updates": "^19.1.2",
        "prettier": "^3.9.6",
        "shx": "^0.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^7.2.2",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vitest": "^4.0.8"
    }
}
